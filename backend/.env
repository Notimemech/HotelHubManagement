# =====================================================
# Backend (.env) — actual local values. Do NOT commit.
# Aligned with docker-compose.yml (SQL Server 2022).
# =====================================================

# Server
PORT=3000

# Database — matches docker-compose.yml
# Note: docker-compose.yml runs SQL Server 2022 on port 1433.
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=HotelHub@2026
DB_NAME=HotelHubManagement

# Auth
# Used by JwtModule (auth.module.ts) and AuthGuard.
# Override this in any non-dev environment.
JWT_SECRET=my-super-secret-key

# Token TTLs (optional — defaults to 15m / 7d if not set)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Sanity self-check (see backend/src/modules/database/sanity.ts)
SANITY_CHECK=false
