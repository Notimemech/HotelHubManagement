# =====================================================
# Backend (.env.example) — copy to .env and fill in.
# Aligned with docker-compose.yml (SQL Server 2022).
# =====================================================

# Server
PORT=3000

# Database — matches docker-compose.yml
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_NAME=HotelHubManagement

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Sanity self-check (set to "true" to run a UUID roundtrip at startup)
SANITY_CHECK=false
