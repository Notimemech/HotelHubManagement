---
title: Staff Module - Class Diagram
---
classDiagram
    class StaffModule {
        <<Module>>
    }

    class StaffController {
        <<Controller>>
        -staffService: StaffService
        +register(dto: RegisterStaffDto) Promise~StaffInfo~
        +findAll() Promise~StaffListItemDto[]~
        +me(req: any) Promise~MyProfileDto~
        +updateMe(req: any, dto: UpdateMyProfileDto) Promise~MyProfileDto~
        +findOne(id: string) Promise~StaffListItemDto~
        +update(id: string, dto: UpdateStaffDto) Promise~StaffInfo~
        +changeRole(id: string, dto: ChangeRoleDto) Promise~void~
    }

    class StaffService {
        <<Service>>
        -staffRepo: Repository~StaffInfo~
        -accountRepo: Repository~Account~
        -dataSource: DataSource
        +createStaff(dto: RegisterStaffDto) Promise~StaffInfo~
        +findAll() Promise~StaffListItemDto[]~
        +findOne(id: string) Promise~StaffListItemDto~
        +findByAccountId(accountId: string) Promise~StaffInfo | null~
        +updateStaff(id: string, dto: UpdateStaffDto) Promise~StaffInfo~
        +updateMyProfile(accountId: string, dto: UpdateMyProfileDto) Promise~StaffInfo~
        +changeRole(id: string, roleName: string) Promise~void~
    }

    class AuthGuard {
        <<Guard>>
    }

    class RolesGuard {
        <<Guard>>
        -reflector: Reflector
        +canActivate(context: ExecutionContext) boolean
    }

    class Roles {
        <<Decorator>>
        +Roles(...roles: string[]) MethodDecorator
    }

    class RegisterStaffDto {
        <<DTO Input>>
        +username: string
        +password: string
        +fullName: string
        +cccd: string
        +phone?: string
        +address?: string
        +birthDate?: string
        +role: string
    }

    class UpdateStaffDto {
        <<DTO Input>>
        +fullName?: string
        +phone?: string
        +address?: string
        +birthDate?: string
        +isActive?: boolean
        +password?: string
    }

    class UpdateMyProfileDto {
        <<DTO Input>>
        +fullName?: string
        +phone?: string
        +address?: string
        +birthDate?: string
    }

    class ChangeRoleDto {
        <<DTO Input>>
        +roleName: string
    }

    class ROLES {
        <<Constant>>
        +Admin
        +Manager
        +Receptionist
        +Saler
        +Cleaner
        +Maintainer
        +User
    }

    class StaffListItemDto {
        <<DTO Output>>
        +staffId: string
        +accountId: string
        +cccd: string
        +fullName: string
        +phone: string
        +address: string
        +birthDate: Date
        +username: string
        +isActive: boolean
        +createdAt: Date
        +role: string
    }

    class MyProfileDto {
        <<DTO Output>>
        +staff: StaffInfo
    }

    class StaffInfo {
        <<Entity>>
        +staffId: string
        +accountId: string
        +cccd: string
        +fullName: string
        +birthDate: Date | null
        +phone: string
        +address: string
        +account: Account
        +versionsInCharge: BookingVersion[]
        +checklistLogs: ChecklistLog[]
        +reportedIssues: IssueReport[]
        +maintenanceProves: MaintenanceProve[]
    }

    StaffModule --> StaffController
    StaffModule --> StaffService
    StaffController --> StaffService
    StaffController ..> AuthGuard : protects all routes
    StaffController ..> RolesGuard : enforces Manager role
    StaffController ..> Roles : declares Manager
    StaffService ..> RegisterStaffDto : consumes
    StaffService ..> UpdateStaffDto : consumes
    StaffService ..> UpdateMyProfileDto : consumes
    StaffService ..> ChangeRoleDto : consumes
    StaffService ..> ROLES : validates roleName
    StaffService ..> StaffInfo : manages
    StaffService ..> Account : manages (via DataSource transaction)
    RolesGuard ..> Roles : resolves metadata