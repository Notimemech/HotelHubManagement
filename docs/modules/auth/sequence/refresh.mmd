---
title: Auth - Refresh Token Flow (POST /auth/refresh)
---
sequenceDiagram
    autonumber
    actor Client
    participant Ctrl as AuthController
    participant Service as AuthService
    participant RefreshTokenModel as RefreshTokenModel (TypeORM Repository)
    participant AccountModel as AccountModel (TypeORM Repository)
    participant Util as Security Utils (bcrypt / crypto / jwt)
    participant DB as Database (SQL Server)

    note right of Client: POST /auth/refresh
    Client->>Ctrl: RefreshTokenDto (refreshToken)
    Ctrl->>Service: refresh(dto)
    Service->>Util: hashToken(refreshToken) (SHA-256)
    Util-->>Service: tokenHash
    Service->>RefreshTokenModel: findOne({ tokenHash })
    RefreshTokenModel->>DB: SELECT * FROM RefreshTokens WHERE TokenHash = ?
    DB-->>RefreshTokenModel: row / null
    RefreshTokenModel-->>Service: RefreshToken Entity / null
    opt Invalid or expired refresh token
        Service-->>Client: Throw UnauthorizedException
    end
    Service->>AccountModel: findOne({ accountId })
    AccountModel->>DB: SELECT * FROM Accounts WHERE AccountId = ?
    DB-->>AccountModel: row / null
    AccountModel-->>Service: Account Entity / null
    opt Inactive account
        Service-->>Client: Throw UnauthorizedException
    end
    Service->>RefreshTokenModel: remove(oldRefreshToken)
    RefreshTokenModel->>DB: DELETE FROM RefreshTokens WHERE Id = ?
    DB-->>RefreshTokenModel: ok
    Service->>Util: jwtService.signAsync(payload)
    Util-->>Service: newAccessToken (15m)
    Service->>Util: crypto.randomBytes(40)
    Util-->>Service: newRawRefreshToken
    Service->>Util: hashToken(newRawRefreshToken) (SHA-256)
    Util-->>Service: newTokenHash
    Service->>RefreshTokenModel: save(newRefreshToken)
    RefreshTokenModel->>DB: INSERT INTO RefreshTokens ...
    DB-->>RefreshTokenModel: persisted row
    RefreshTokenModel-->>Service: RefreshToken Entity
    Service-->>Ctrl: TokenPairDto (accessToken, refreshToken)
    Ctrl-->>Client: HTTP 200 - TokenPairDto