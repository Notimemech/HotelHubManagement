---
title: Accounts Module - Class Diagram
---
classDiagram
    class AccountsModule {
        <<Module>>
    }

    class AccountsService {
        <<Service>>
        -accountRepo: Repository~Account~
        +create(username: string, passwordHash: string) Promise~Account~
        +findByUsername(username: string) Promise~Account | null~
        +findById(id: string) Promise~Account | null~
        +getRoles(accountId: string) Promise~string[]~
        +setRole(accountId: string, roleName: string) Promise~void~
    }

    class Roles {
        <<Constant>>
        +ROLES: Admin | Manager | Receptionist | Saler | Cleaner | Maintainer | User
        +isValidRole(role: string) boolean
    }

    AccountsModule --> AccountsService
    AccountsService ..> Roles : validates role name