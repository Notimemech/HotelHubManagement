sequenceDiagram
    autonumber
    actor Client as Cleaner
    participant Ctrl as HousekeepingController
    participant Service as HousekeepingService
    participant StaffSvc as StaffService
    participant DB as Database

    note right of Client: POST /housekeeping/logs (Bearer Token)
    Client->>Ctrl: LogChecklistDto
    activate Ctrl
    Ctrl->>Ctrl: AuthGuard & RolesGuard

    Ctrl->>Service: logChecklist(accountId, dto)
    activate Service
    
    Service->>StaffSvc: findByAccountId(accountId)
    StaffSvc-->>Service: StaffInfo
    
    alt Staff not found
        Service-->>Client: 403 Forbidden
    end

    Service->>DB: Check assignment (RoomID, CleanerId)
    DB-->>Service: RoomAssignment
    
    alt Not assigned
        Service-->>Client: 403 Forbidden
    end

    Service->>DB: INSERT ChecklistLog
    DB-->>Service: ChecklistLog

    Service-->>Ctrl: ChecklistLog
    deactivate Service
    
    Ctrl-->>Client: 201 Created
    deactivate Ctrl